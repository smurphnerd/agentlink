{
  "name": "agentlink",
  "version": "0.1.0",
  "description": "One source of truth for agent instructions and skills, symlinked into every coding-agent harness.",
  "keywords": [
    "agents.md",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "symlink",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentlink": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CONVENTION.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
